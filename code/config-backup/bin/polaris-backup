#!/usr/bin/env bash

###############################################################################
#
# Project Polaris
#
# Script:
#     polaris-backup
#
# Component:
#     Configuration Backup Orchestrator
#
# Version:
#     0.2.0
#
# Purpose:
#     Coordinate Project Polaris configuration collection, validation,
#     replication to NAS01, copy validation, quarantine handling, and retention.
#
# Current Scope:
#     Registry-driven; see POLARIS_COLLECTOR_IDS below for the authoritative,
#     current list of active collectors.
#
# Workflow:
#     1. Acquire execution lock.
#     2. Validate local prerequisites.
#     3. Run the Proxmox collector.
#     4. Validate the local collector output.
#     5. Preserve valid output locally or quarantine invalid output.
#     6. Copy valid output to NAS01 when available.
#     7. Validate the NAS01 copy.
#     8. Promote valid NAS copies or quarantine invalid copies.
#     9. Apply retention to validated backups.
#    10. Apply separate retention to quarantined backups.
#
###############################################################################

###############################################################################
# Shell behavior
###############################################################################

set -u
set -o pipefail

###############################################################################
# Constants
###############################################################################

readonly POLARIS_BACKUP_NAME="Project Polaris Backup Orchestrator"
readonly POLARIS_BACKUP_VERSION="0.2.0"

readonly POLARIS_COLLECTOR_NEW_OR_CHANGED=10
readonly POLARIS_COLLECTOR_FAILED=11
readonly POLARIS_COLLECTOR_NO_CHANGE=12

# Raw collector public-interface result contract.
readonly POLARIS_COLLECTOR_RESULT_SUCCESS=0
readonly POLARIS_COLLECTOR_RESULT_ERROR=1
readonly POLARIS_COLLECTOR_RESULT_NO_CHANGE=2

###############################################################################
# Collector lifecycle states
###############################################################################

readonly POLARIS_COLLECTOR_STATE_REGISTERED="REGISTERED"
readonly POLARIS_COLLECTOR_STATE_RUNNING="RUNNING"
readonly POLARIS_COLLECTOR_STATE_COLLECTED="COLLECTED"
readonly POLARIS_COLLECTOR_STATE_NO_CHANGE="NO_CHANGE"
readonly POLARIS_COLLECTOR_STATE_FAILED="FAILED"
readonly POLARIS_COLLECTOR_STATE_LIFECYCLE_FAILED="LIFECYCLE_FAILED"
readonly POLARIS_COLLECTOR_STATE_COMPLETE="COMPLETE"
readonly POLARIS_COLLECTOR_STATE_INTERNAL_ERROR="INTERNAL_ERROR"

###############################################################################
# Load common library
#
# The common library owns shared Project Polaris path constants. The
# orchestrator resolves only the library path needed to bootstrap that import.
###############################################################################

POLARIS_BACKUP_SCRIPT_DIRECTORY="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P
)"

readonly POLARIS_COMMON_LIBRARY="${POLARIS_BACKUP_SCRIPT_DIRECTORY}/../lib/polaris-common.sh"

if [[ ! -r "${POLARIS_COMMON_LIBRARY}" ]]; then
    printf 'ERROR: Project Polaris common library not found or unreadable: %s\n' \
        "${POLARIS_COMMON_LIBRARY}" >&2
    exit 2 # POLARIS_BACKUP_PREREQUISITE_FAILED - hardcoded: the common
           # library (which defines this symbolically) is what just failed
           # to load, so the symbol itself isn't available yet here.
fi

# shellcheck source=/dev/null
source "${POLARIS_COMMON_LIBRARY}"

