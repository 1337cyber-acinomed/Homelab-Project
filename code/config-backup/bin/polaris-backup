###############################################################################
# Module state
###############################################################################

POLARIS_RUN_TIMESTAMP=""
POLARIS_LOCK_DESCRIPTOR=""

declare -A POLARIS_COLLECTOR_STATES=()
declare -A POLARIS_COLLECTOR_RESULTS=()

###############################################################################
# Function:
#     main
#
# Purpose:
#     Coordinate independent configuration-backup lifecycles for all
#     registered Project Polaris collectors.
###############################################################################

main() {

    local overall_result="${POLARIS_BACKUP_SUCCESS}"
    local collector_id
    local collector_result
    local lifecycle_result

    log_info \
        "Starting ${POLARIS_BACKUP_NAME} v${POLARIS_BACKUP_VERSION}"

    _initialize_run || return $?
    _apply_log_retention || return $?
    _acquire_lock || return $?

    trap '_release_lock' EXIT
    trap '_handle_interruption' INT TERM HUP

    _validate_local_environment || return $?
    _prepare_local_directories || return $?
    _initialize_collector_lifecycle_state

    for collector_id in "${POLARIS_COLLECTOR_IDS[@]}"; do
        _execute_registered_collector "${collector_id}"
        collector_result=$?

        overall_result="$(_merge_workflow_result \
            "${overall_result}" \
            "${collector_result}")"
    done

    _apply_all_retention
    lifecycle_result=$?

    if (( lifecycle_result != POLARIS_BACKUP_SUCCESS )); then
        operator_error "Scheduled retention did not complete successfully."

        overall_result="$(_merge_workflow_result \
            "${overall_result}" \
            "${lifecycle_result}")"
    fi

    _finalize_workflow "${overall_result}"
    return $?
}

###############################################################################
# Function:
#     _initialize_collector_lifecycle_state
#
# Purpose:
#     Reset the in-memory lifecycle state and result for every registered
#     collector at the beginning of one orchestrator execution.
###############################################################################

_initialize_collector_lifecycle_state() {

    local collector_id

    POLARIS_COLLECTOR_STATES=()
    POLARIS_COLLECTOR_RESULTS=()

    for collector_id in "${POLARIS_COLLECTOR_IDS[@]}"; do
        POLARIS_COLLECTOR_STATES["${collector_id}"]="${POLARIS_COLLECTOR_STATE_REGISTERED}"
        POLARIS_COLLECTOR_RESULTS["${collector_id}"]="${POLARIS_BACKUP_SUCCESS}"
    done
}

###############################################################################
# Function:
#     _set_collector_lifecycle_state
#
# Purpose:
#     Record one collector's current lifecycle state and normalized workflow
#     result without changing operator-visible output.
#
# Arguments:
#     $1 - Collector registry ID
#     $2 - Lifecycle state
#     $3 - Normalized workflow result
###############################################################################

_set_collector_lifecycle_state() {

    local collector_id="${1:-}"
    local lifecycle_state="${2:-}"
    local workflow_result="${3:-}"

    if [[ -z "${collector_id}" ]] ||
       [[ -z "${POLARIS_COLLECTOR_DISPLAY_NAMES[${collector_id}]:-}" ]] ||
       [[ -z "${lifecycle_state}" ]] ||
       [[ -z "${workflow_result}" ]]; then
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    POLARIS_COLLECTOR_STATES["${collector_id}"]="${lifecycle_state}"
    POLARIS_COLLECTOR_RESULTS["${collector_id}"]="${workflow_result}"

    log_info \
        "Collector lifecycle state: ${collector_id}=${lifecycle_state}; result=${workflow_result}"

    return "${POLARIS_BACKUP_SUCCESS}"
}

###############################################################################
# Function:
#     _workflow_result_precedence
#
# Purpose:
#     Return the deterministic precedence assigned to one normalized workflow
#     result. Higher values represent more severe failures.
###############################################################################

_workflow_result_precedence() {

    local workflow_result="${1:-${POLARIS_BACKUP_INTERNAL_ERROR}}"

    case "${workflow_result}" in
        "${POLARIS_BACKUP_SUCCESS}")
            printf '0\n'
            ;;
        "${POLARIS_BACKUP_FAILED}")
            printf '10\n'
            ;;
        "${POLARIS_BACKUP_PREREQUISITE_FAILED}")
            printf '20\n'
            ;;
        "${POLARIS_BACKUP_NAS_FAILED}")
            printf '30\n'
            ;;
        "${POLARIS_BACKUP_LOCKED}")
            printf '40\n'
            ;;
        "${POLARIS_BACKUP_INTERNAL_ERROR}")
            printf '50\n'
            ;;
        *)
            printf '50\n'
            ;;
    esac
}

###############################################################################
# Function:
#     _merge_workflow_result
#
# Purpose:
#     Select the more severe of two workflow results using deterministic
#     precedence so later lower-severity outcomes cannot mask earlier failures.
###############################################################################

_merge_workflow_result() {

    local current_result="${1:-${POLARIS_BACKUP_SUCCESS}}"
    local candidate_result="${2:-${POLARIS_BACKUP_INTERNAL_ERROR}}"
    local current_precedence
    local candidate_precedence

    current_precedence="$(_workflow_result_precedence "${current_result}")"
    candidate_precedence="$(_workflow_result_precedence "${candidate_result}")"

    if (( candidate_precedence > current_precedence )); then
        printf '%s\n' "${candidate_result}"
    else
        printf '%s\n' "${current_result}"
    fi
}

###############################################################################
# Function:
#     _finalize_workflow
#
# Purpose:
#     Emit the final operator result and return the authoritative workflow exit
#     status from one centralized completion path.
###############################################################################

_finalize_workflow() {

    local overall_result="${1:-${POLARIS_BACKUP_INTERNAL_ERROR}}"

    if (( overall_result == POLARIS_BACKUP_SUCCESS )); then
        operator_success \
            "Project Polaris backup workflow completed successfully."
        return "${POLARIS_BACKUP_SUCCESS}"
    fi

    operator_error \
        "Project Polaris backup workflow completed with one or more failures."

    return "${overall_result}"
}

###############################################################################
# Function:
#     _execute_registered_collector
#
# Purpose:
#     Execute one registry-owned collector and apply the common result/lifecycle
#     workflow without hiding collector-specific messages or collection logic.
###############################################################################

_execute_registered_collector() {

    local collector_id="${1:-}"
    local display_name
    local runner_function
    local working_directory
    local backup_prefix
    local backup_name
    local validated_directory
    local quarantine_directory
    local collector_result
    local lifecycle_result

    if [[ -z "${collector_id}" ]] ||
       [[ -z "${POLARIS_COLLECTOR_DISPLAY_NAMES[${collector_id}]:-}" ]]; then
        operator_error \
            "Collector execution requested for an unknown registry ID: ${collector_id:-<empty>}"
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    display_name="${POLARIS_COLLECTOR_DISPLAY_NAMES[${collector_id}]}"
    runner_function="${POLARIS_COLLECTOR_RUNNERS[${collector_id}]}"
    working_directory="${POLARIS_COLLECTOR_WORKING_PATHS[${collector_id}]}"
    backup_prefix="${POLARIS_COLLECTOR_BACKUP_PREFIXES[${collector_id}]}"

    # Tag every operator_*/log_* warning and error raised for the duration of
    # this collector's run with its registry ID. Cleared on every return path
    # via trap so a later untagged (orchestrator-level) message never
    # accidentally inherits a previous collector's name.
    POLARIS_ACTIVE_COLLECTOR="${collector_id}"
    trap 'POLARIS_ACTIVE_COLLECTOR=""' RETURN

    backup_name="${backup_prefix}-${POLARIS_RUN_TIMESTAMP}"
    validated_directory="${POLARIS_LOCAL_VALIDATED_ROOT}/${collector_id}/${backup_name}"
    quarantine_directory="${POLARIS_LOCAL_QUARANTINE_ROOT}/${collector_id}/${backup_name}"

    if ! declare -F "${runner_function}" >/dev/null 2>&1; then
        operator_error \
            "${display_name} collector runner is not available: ${runner_function}"
        _set_collector_lifecycle_state \
            "${collector_id}" \
            "${POLARIS_COLLECTOR_STATE_INTERNAL_ERROR}" \
            "${POLARIS_BACKUP_INTERNAL_ERROR}" || true
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    _set_collector_lifecycle_state \
        "${collector_id}" \
        "${POLARIS_COLLECTOR_STATE_RUNNING}" \
        "${POLARIS_BACKUP_SUCCESS}" || return "${POLARIS_BACKUP_INTERNAL_ERROR}"

    "${runner_function}"
    collector_result=$?

    case "${collector_result}" in
        "${POLARIS_COLLECTOR_NEW_OR_CHANGED}")
            _process_collector_lifecycle \
                "${collector_id}" \
                "${display_name}" \
                "${working_directory}" \
                "${validated_directory}" \
                "${quarantine_directory}"

            lifecycle_result=$?

            if (( lifecycle_result != POLARIS_BACKUP_SUCCESS )); then
                operator_error \
                    "${display_name} backup lifecycle did not complete successfully."

                _set_collector_lifecycle_state \
                    "${collector_id}" \
                    "${POLARIS_COLLECTOR_STATE_LIFECYCLE_FAILED}" \
                    "${lifecycle_result}" || true
            else
                _set_collector_lifecycle_state \
                    "${collector_id}" \
                    "${POLARIS_COLLECTOR_STATE_COMPLETE}" \
                    "${POLARIS_BACKUP_SUCCESS}" || true
            fi

            return "${lifecycle_result}"
            ;;

        "${POLARIS_COLLECTOR_NO_CHANGE}")
            log_info \
                "${POLARIS_COLLECTOR_NO_CHANGE_MESSAGES[${collector_id}]}"

            _set_collector_lifecycle_state \
                "${collector_id}" \
                "${POLARIS_COLLECTOR_STATE_NO_CHANGE}" \
                "${POLARIS_BACKUP_SUCCESS}" || true

            return "${POLARIS_BACKUP_SUCCESS}"
            ;;

        "${POLARIS_COLLECTOR_FAILED}")
            operator_error \
                "${display_name} collection failed. Lifecycle processing was skipped."

            if [[ -d "${working_directory}" ]] &&
               [[ -n "$(find "${working_directory}" \
                    -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then

                _quarantine_local_backup \
                    "${display_name}" \
                    "${working_directory}" \
                    "${quarantine_directory}" || \
                    operator_error \
                        "Failed ${display_name} collector output could not be quarantined."
            fi

            _set_collector_lifecycle_state \
                "${collector_id}" \
                "${POLARIS_COLLECTOR_STATE_FAILED}" \
                "${POLARIS_BACKUP_FAILED}" || true

            return "${POLARIS_BACKUP_FAILED}"
            ;;

        *)
            operator_error \
                "${display_name} collector wrapper returned unexpected status: ${collector_result}"

            _set_collector_lifecycle_state \
                "${collector_id}" \
                "${POLARIS_COLLECTOR_STATE_INTERNAL_ERROR}" \
                "${POLARIS_BACKUP_INTERNAL_ERROR}" || true

            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
            ;;
    esac
}

###############################################################################
# Function:
#     _initialize_run
#
# Purpose:
#     Generate the shared execution timestamp and initialize the orchestrator
#     run log.
###############################################################################

_initialize_run() {

    local orchestrator_log_directory

    if ! POLARIS_RUN_TIMESTAMP="$(generate_timestamp)"; then
        operator_error \
            "Unable to generate backup timestamp."

        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    if [[ -z "${POLARIS_RUN_TIMESTAMP}" ]]; then
        operator_error \
            "Backup timestamp was generated as an empty value."

        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    orchestrator_log_directory="${POLARIS_LOG_DIR}/orchestrator"

    POLARIS_ACTIVE_LOG_FILE="${orchestrator_log_directory}/project-polaris-backup-${POLARIS_RUN_TIMESTAMP}.log"

    if ! log_info \
        "Project Polaris backup orchestrator initialized."; then

        operator_error \
            "Unable to initialize the orchestrator run log."

        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    log_info \
        "Run timestamp: ${POLARIS_RUN_TIMESTAMP}" || \
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"

    local collector_id

    for collector_id in "${POLARIS_COLLECTOR_IDS[@]}"; do
        log_info \
            "Registered collector: ${POLARIS_COLLECTOR_DISPLAY_NAMES[${collector_id}]}" || \
            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    done

    operator_info \
        "Orchestrator initialized"

    return "${POLARIS_BACKUP_SUCCESS}"
}

###############################################################################
# Function:
#     _apply_log_retention
#
# Purpose:
#     Remove expired per-run orchestrator logs before scheduled execution
#     continues. The active run log and size-based framework-log rotation are
#     preserved independently.
###############################################################################

_apply_log_retention() {

    local orchestrator_log_directory="${POLARIS_LOG_DIR}/orchestrator"
    local expired_log
    local retention_failed=0

    if [[ ! -d "${orchestrator_log_directory}" ]]; then
        return "${POLARIS_BACKUP_SUCCESS}"
    fi

    while IFS= read -r -d '' expired_log; do
        if [[ "${expired_log}" == "${POLARIS_ACTIVE_LOG_FILE}" ]]; then
            continue
        fi

        if ! rm -f -- "${expired_log}"; then
            operator_warning                 "Unable to remove expired orchestrator log: ${expired_log}"
            log_warning                 "Unable to remove expired orchestrator log: ${expired_log}"
            retention_failed=1
        else
            log_info                 "Removed expired orchestrator log: ${expired_log}"
        fi
    done < <(
        find "${orchestrator_log_directory}"             -mindepth 1             -maxdepth 1             -type f             -name 'project-polaris-backup-*.log'             -mtime "+${POLARIS_ORCHESTRATOR_LOG_RETENTION_DAYS}"             -print0
    )

    if (( retention_failed != 0 )); then
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    log_info         "Orchestrator log retention completed: ${POLARIS_ORCHESTRATOR_LOG_RETENTION_DAYS} days."

    return "${POLARIS_BACKUP_SUCCESS}"
}

###############################################################################
# Function:
#     _acquire_lock
#
# Purpose:
#     Prevent overlapping cron executions.
###############################################################################

_acquire_lock() {

    local lock_directory

    lock_directory="$(dirname -- "${POLARIS_LOCK_FILE}")"

    if ! command -v flock >/dev/null 2>&1; then
        operator_error "Required command not found: flock"
        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi

    if ! create_directory "${lock_directory}"; then
        operator_error "Unable to create lock directory: ${lock_directory}"
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    if ! exec {POLARIS_LOCK_DESCRIPTOR}> "${POLARIS_LOCK_FILE}"; then
        operator_error "Unable to open lock file: ${POLARIS_LOCK_FILE}"
        POLARIS_LOCK_DESCRIPTOR=""
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    if ! flock -n "${POLARIS_LOCK_DESCRIPTOR}"; then
        operator_error "Another Project Polaris backup operation is already running."

        exec {POLARIS_LOCK_DESCRIPTOR}>&-
        POLARIS_LOCK_DESCRIPTOR=""

        return "${POLARIS_BACKUP_LOCKED}"
    fi

    log_info "Execution lock acquired: ${POLARIS_LOCK_FILE}"

    return "${POLARIS_BACKUP_SUCCESS}"
}

###############################################################################
# Function:
#     _release_lock
#
# Purpose:
#     Release the execution lock.
###############################################################################

_release_lock() {

    if [[ -z "${POLARIS_LOCK_DESCRIPTOR}" ]]; then
        return "${POLARIS_BACKUP_SUCCESS}"
    fi

    if [[ ! "${POLARIS_LOCK_DESCRIPTOR}" =~ ^[0-9]+$ ]]; then
        operator_warning "Lock descriptor is invalid and could not be explicitly released."
        POLARIS_LOCK_DESCRIPTOR=""
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    if ! flock -u "${POLARIS_LOCK_DESCRIPTOR}"; then
        operator_warning "Unable to explicitly unlock: ${POLARIS_LOCK_FILE}"
    fi

    exec {POLARIS_LOCK_DESCRIPTOR}>&-
    POLARIS_LOCK_DESCRIPTOR=""

    log_info "Execution lock released."

    return "${POLARIS_BACKUP_SUCCESS}"
}

###############################################################################
# Function:
#     _handle_interruption
#
# Purpose:
#     Handle termination signals while preserving working data.
###############################################################################

_handle_interruption() {

    operator_error "Backup workflow interrupted."

    exit "${POLARIS_BACKUP_FAILED}"
}

###############################################################################
# Function:
#     _validate_local_environment
#
# Purpose:
#     Confirm local scripts, commands, and directories are available.
###############################################################################

_validate_local_environment() {

    local required_command
    local collector_id
    local collector_display_name
    local collector_script
    local required_commands=(
        "bash"
        "date"
        "dirname"
        "find"
        "flock"
        "mv"
        "rm"
    )

    if (( EUID != 0 )); then
        operator_error "The backup orchestrator must be run as root."
        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi

    for required_command in "${required_commands[@]}"; do
        if ! command -v "${required_command}" >/dev/null 2>&1; then
            operator_error "Required command not found: ${required_command}"
            return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
        fi
    done

    for collector_id in "${POLARIS_COLLECTOR_IDS[@]}"; do
        collector_display_name="${POLARIS_COLLECTOR_DISPLAY_NAMES[${collector_id}]}"
        collector_script="${POLARIS_COLLECTOR_SCRIPT_PATHS[${collector_id}]}"

        if [[ ! -f "${collector_script}" ]]; then
            operator_error \n                "${collector_display_name} collector not found: ${collector_script}"
            return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
        fi

        if [[ ! -r "${collector_script}" ]]; then
            operator_error \n                "${collector_display_name} collector is not readable: ${collector_script}"
            return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
        fi
    done

    if [[ ! -f "${POLARIS_MANIFEST_VALIDATOR}" ]]; then
        operator_error "Manifest validator not found: ${POLARIS_MANIFEST_VALIDATOR}"
        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi

    if [[ ! -r "${POLARIS_MANIFEST_VALIDATOR}" ]]; then
        operator_error "Manifest validator is not readable: ${POLARIS_MANIFEST_VALIDATOR}"
        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi

    if [[ ! -d "${POLARIS_LOCAL_ROOT}" ]]; then
        if ! create_directory "${POLARIS_LOCAL_ROOT}"; then
            operator_error "Unable to create local backup root: ${POLARIS_LOCAL_ROOT}"
            return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
        fi
    fi

    if [[ ! -w "${POLARIS_LOCAL_ROOT}" ]]; then
        operator_error "Local backup root is not writable: ${POLARIS_LOCAL_ROOT}"
        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi

    log_info "Local backup environment validated for all registered collectors."

    return "${POLARIS_BACKUP_SUCCESS}"
}
###############################################################################
# Function:
#     _recover_abandoned_working_directory
#
# Purpose:
#     Preserve an abandoned collector working directory in quarantine, record
#     the recovery reason, and allow the orchestrator startup sequence to
#     continue without pre-creating the collector-owned staging root.
###############################################################################

_recover_abandoned_working_directory() {

    local collector_id="$1"
    local collector_display_name="$2"
    local working_directory="$3"
    local quarantine_directory
    local quarantine_reason_file
    local collision_index=0

    if [[ -z "${collector_id}" || -z "${collector_display_name}" || -z "${working_directory}" ]]; then
        operator_error "Interrupted-run recovery received incomplete collector information."
        log_error "Interrupted-run recovery requires collector ID, display name, and working directory."
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    quarantine_directory="${POLARIS_LOCAL_QUARANTINE_ROOT}/${collector_id}/interrupted-run-${POLARIS_RUN_TIMESTAMP}"

    while [[ -e "${quarantine_directory}" ]]; do
        collision_index=$(( collision_index + 1 ))
        quarantine_directory="${POLARIS_LOCAL_QUARANTINE_ROOT}/${collector_id}/interrupted-run-${POLARIS_RUN_TIMESTAMP}-${collision_index}"
    done

    if ! mv -- "${working_directory}" "${quarantine_directory}"; then
        operator_error "Unable to preserve abandoned ${collector_display_name} working data."
        log_error "Unable to move abandoned working directory from ${working_directory} to ${quarantine_directory}."
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    quarantine_reason_file="${quarantine_directory}/QUARANTINE-REASON.txt"

    if ! cat >"${quarantine_reason_file}" <<EOF
Project Polaris interrupted-run preservation

Collector: ${collector_display_name}
Original Path: ${working_directory}
Preserved Path: ${quarantine_directory}
Preserved At (UTC): $(date -u +'%Y-%m-%dT%H:%M:%SZ')
Reason: Non-empty collector working directory remained from an earlier or interrupted run.
Disposition: Preserved automatically during orchestrator startup; collection continued with a clean workspace.
EOF
    then
        operator_error "Unable to record quarantine reason for abandoned ${collector_display_name} data."
        log_error "Unable to write quarantine reason file: ${quarantine_reason_file}"
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    if ! chmod 600 "${quarantine_reason_file}"; then
        operator_error "Unable to secure quarantine reason for abandoned ${collector_display_name} data."
        log_error "Unable to set permissions on quarantine reason file: ${quarantine_reason_file}"
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    operator_warning "Preserved abandoned ${collector_display_name} working data and continued startup."
    log_warning "Abandoned ${collector_display_name} working data preserved at: ${quarantine_directory}"

    return "${POLARIS_BACKUP_SUCCESS}"
}

###############################################################################
# Function:
#     _prepare_local_directories
#
# Purpose:
#     Prepare local validated and quarantine storage locations.
###############################################################################

_prepare_local_directories() {

    local required_directory
    local collector_id
    local collector_display_name
    local working_directory
    local required_directories=(
        "${POLARIS_LOCAL_CURRENT_ROOT}"
        "${POLARIS_LOCAL_VALIDATED_ROOT}"
        "${POLARIS_LOCAL_QUARANTINE_ROOT}"
        "${POLARIS_LOCAL_ROOT}/archive"
        "${POLARIS_LOCAL_TROUBLESHOOTING_ROOT}"
    )

    for collector_id in "${POLARIS_COLLECTOR_IDS[@]}"; do
        required_directories+=(
            "${POLARIS_LOCAL_VALIDATED_ROOT}/${collector_id}"
            "${POLARIS_LOCAL_QUARANTINE_ROOT}/${collector_id}"
            "${POLARIS_LOCAL_ROOT}/archive/${collector_id}"
            "${POLARIS_COLLECTOR_TROUBLESHOOTING_PATHS[${collector_id}]}"
        )
    done

    for required_directory in "${required_directories[@]}"; do
        if ! create_directory "${required_directory}"; then
            operator_error "Unable to create local backup directory: ${required_directory}"
            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
        fi
    done

    for collector_id in "${POLARIS_COLLECTOR_IDS[@]}"; do
        collector_display_name="${POLARIS_COLLECTOR_DISPLAY_NAMES[${collector_id}]}"
        working_directory="${POLARIS_COLLECTOR_WORKING_PATHS[${collector_id}]}"

        if [[ -e "${working_directory}" && ! -d "${working_directory}" ]]; then
            operator_error \n                "${collector_display_name} working path exists but is not a directory: ${working_directory}"
            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
        fi

        if [[ -d "${working_directory}" ]] &&
           [[ -n "$(find "${working_directory}" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
            if ! _recover_abandoned_working_directory \n                "${collector_id}" \n                "${collector_display_name}" \n                "${working_directory}"; then
                return "${POLARIS_BACKUP_INTERNAL_ERROR}"
            fi
        fi

        if [[ -d "${working_directory}" ]]; then
            if ! rmdir -- "${working_directory}"; then
                operator_error \n                    "Unable to remove empty ${collector_display_name} working directory: ${working_directory}"
                log_error \n                    "Collector-owned staging root could not be removed before invocation: ${working_directory}"
                return "${POLARIS_BACKUP_INTERNAL_ERROR}"
            fi
        fi
    done

    log_info "Local backup directories prepared for all registered collectors."
    return "${POLARIS_BACKUP_SUCCESS}"
}

###############################################################################
# Function:
#     _run_proxmox_collector
#
# Purpose:
#     Run the production Proxmox collector.
###############################################################################
 
_run_proxmox_collector() {
 
    local collector_result
    local collector_start_seconds
    local collector_elapsed_seconds
 
    collector_start_seconds="${SECONDS}"
 
    if [[ ! -r "${POLARIS_PROXMOX_COLLECTOR}" ]]; then
        collector_elapsed_seconds=$(( SECONDS - collector_start_seconds ))
 
        operator_error "Proxmox collector is not readable: ${POLARIS_PROXMOX_COLLECTOR}"
        log_error "Proxmox collector is not readable: ${POLARIS_PROXMOX_COLLECTOR}"
        log_error "Proxmox collector elapsed time: ${collector_elapsed_seconds} seconds."
 
        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi
 
    # shellcheck source=/dev/null
    source "${POLARIS_PROXMOX_COLLECTOR}" || {
        collector_elapsed_seconds=$(( SECONDS - collector_start_seconds ))
 
        operator_error "Unable to load Proxmox collector: ${POLARIS_PROXMOX_COLLECTOR}"
        log_error "Unable to load Proxmox collector: ${POLARIS_PROXMOX_COLLECTOR}"
        log_error "Proxmox collector elapsed time: ${collector_elapsed_seconds} seconds."
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    }
 
    if ! declare -F collect_proxmox >/dev/null 2>&1; then
        collector_elapsed_seconds=$(( SECONDS - collector_start_seconds ))
 
        operator_error "Proxmox collector public interface is unavailable: collect_proxmox"
        log_error "Proxmox collector interface is unavailable: collect_proxmox"
        log_error "Proxmox collector elapsed time: ${collector_elapsed_seconds} seconds."
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi
 
    operator_info "Running Proxmox collector."
    log_info "Starting Proxmox collector."
    log_info "Collector name: ${MODULE_DISPLAY_NAME}"
    log_info "Collector Version: ${MODULE_VERSION}"
    log_info "Run Identity: ${POLARIS_RUN_TIMESTAMP}"
    log_info "Collector destination: ${POLARIS_PROXMOX_WORKING_DIRECTORY}"
    log_info "Collector destination: ${POLARIS_PROXMOX_WORKING_DIRECTORY}"
 
    log_info "Invoking Proxmox collector interface: collect_proxmox"
    (
        if [[ -n "${POLARIS_LOCK_DESCRIPTOR:-}" ]]; then
            exec {POLARIS_LOCK_DESCRIPTOR}>&-
        fi
 
        collect_proxmox "${POLARIS_PROXMOX_WORKING_DIRECTORY}"
    )
    collector_result=$?
 
    collector_elapsed_seconds=$(( SECONDS - collector_start_seconds ))
 
    case "${collector_result}" in
        "${POLARIS_COLLECTOR_RESULT_SUCCESS}")
            operator_success "Proxmox collector completed successfully."
            log_info "Proxmox collector completed successfully."
            log_info "Collector execution completed successfully."
            log_info "Collector exit code: ${collector_result}"
            log_info "Proxmox collector elapsed time: ${collector_elapsed_seconds} seconds."
            return "${POLARIS_COLLECTOR_NEW_OR_CHANGED}"
            ;;
 
        "${POLARIS_COLLECTOR_RESULT_ERROR}")
            operator_error "Proxmox collector encountered an error."
            log_error "Proxmox collector failed"
            log_error "Collector exit code: ${collector_result}"
            log_error "Proxmox collector elapsed time: ${collector_elapsed_seconds} seconds."
            return "${POLARIS_COLLECTOR_FAILED}"
            ;;
 
        "${POLARIS_COLLECTOR_RESULT_NO_CHANGE}")
            operator_error "Proxmox collector returned unsupported no-change status."
            log_error "Proxmox collector unexpectedly returned no-change."
            log_error "Collector exit code: ${collector_result}"
            log_error "Proxmox collector elapsed time: ${collector_elapsed_seconds} seconds."
            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
            ;;
 
        *)
            operator_error "Proxmox collector returned an unexpected result."
            log_error "Proxmox collector returned unexpected exit code: ${collector_result}"
            log_error "Proxmox collector elapsed time: ${collector_elapsed_seconds} seconds."
            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
            ;;
    esac
}
 
###############################################################################
# Function:
#     _run_pfsense_collector()
#
# Purpose:
#     Run pfSense-based collector.
#
#     NOTE: this collector targets Firewall01, the original homelab/house
#     boundary firewall. gateway01 (also pfSense software, added later in
#     the network buildout) is a separate collector entirely - see
#     _run_gateway01_collector(). The internal registry ID and NAS archive
#     naming remain "pfsense" for backward compatibility with existing
#     backup history; only human-facing log/notification text below says
#     "Firewall01" explicitly, to stay distinguishable from Gateway01.
###############################################################################
 
_run_pfsense_collector() {
 
    local collector_result
    local collector_start_seconds
    local collector_elapsed_seconds
    local baseline_file=""
    local nas_validated_archive=""
 
    collector_start_seconds="${SECONDS}"
 
    if [[ ! -r "${POLARIS_PFSENSE_COLLECTOR}" ]]; then
        operator_error \
            "Firewall01 collector is not readable: ${POLARIS_PFSENSE_COLLECTOR}"
 
        log_error \
            "Firewall01 collector is not readable: ${POLARIS_PFSENSE_COLLECTOR}"
 
        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi
 
    if ! source "${POLARIS_PFSENSE_COLLECTOR}"; then
        operator_error \
            "Unable to load Firewall01 collector: ${POLARIS_PFSENSE_COLLECTOR}"
 
        log_error \
            "Unable to load Firewall01 collector: ${POLARIS_PFSENSE_COLLECTOR}"
 
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi
 
    if ! declare -F collect_pfsense >/dev/null; then
        operator_error \
            "Firewall01 collector did not expose the required collect_pfsense interface."
 
        log_error \
            "Firewall01 collector did not expose the required collect_pfsense interface."
 
        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi
 
    operator_info "Running Firewall01 collector."
 
    log_info "========================================================================"
    log_info "COLLECTOR START: Firewall01"
    log_info "Run identity: ${POLARIS_RUN_TIMESTAMP}"
    log_info "Collector destination: ${POLARIS_PFSENSE_WORKING_DIRECTORY}"
    log_info "Troubleshooting root: ${POLARIS_PFSENSE_TROUBLESHOOTING_ROOT}"
    log_info "========================================================================"
 
    log_info \
        "Collector destination: ${POLARIS_PFSENSE_WORKING_DIRECTORY}"
 
    nas_validated_archive="$(
        find "${POLARIS_NAS_VALIDATED_ROOT}/pfsense" \
            -mindepth 2 \
            -maxdepth 2 \
            -type f \
            -name 'pfSense-*.tar.zst' \
            -printf '%T@ %p\n' \
            2>/dev/null \
        | sort -nr \
        | head -n 1 \
        | cut -d' ' -f2-
    )"
 
    if [[ -n "${nas_validated_archive}" ]]; then
 
        log_info \
            "Existing validated Firewall01 NAS backup located: ${nas_validated_archive}"
 
        log_info \
            "Existing validated Firewall01 NAS backup located: ${nas_validated_archive}"
 
        baseline_file="$(
            find "${POLARIS_LOCAL_VALIDATED_ROOT}/pfsense" \
                -mindepth 3 \
                -maxdepth 3 \
                -type f \
                -path '*/configuration/config.xml' \
                -printf '%T@ %p\n' \
                2>/dev/null \
            | sort -nr \
            | head -n 1 \
            | cut -d' ' -f2-
        )"
 
        if [[ -n "${baseline_file}" ]]; then
            log_info \
                "Firewall01 comparison baseline located: ${baseline_file}"
 
            log_info \
                "Firewall01 comparison baseline located: ${baseline_file}"
        else
            operator_warning \
                "A validated Firewall01 NAS backup exists, but no local comparison baseline was found."
 
            log_warning \
                "A validated Firewall01 NAS backup exists, but no local comparison baseline was found."
 
            log_info \
                "The current Firewall01 configuration will be treated as new."
        fi
 
    else
        log_info \
            "No validated Firewall01 NAS backup exists. The current configuration will be treated as the initial backup."
 
        log_info \
            "No validated Firewall01 NAS backup exists. Local baseline comparison was intentionally skipped."
    fi
 
    collect_pfsense \
        "${POLARIS_PFSENSE_WORKING_DIRECTORY}" \
        "${baseline_file}" \
        "${POLARIS_PFSENSE_TROUBLESHOOTING_ROOT}"
 
    collector_result=$?
    collector_elapsed_seconds=$((SECONDS - collector_start_seconds))
 
    case "${collector_result}" in
        "${POLARIS_COLLECTOR_RESULT_SUCCESS}")
            operator_success \
                "Firewall01 collector completed successfully."
 
            log_info "Firewall01 collector completed successfully."
            log_info "Collector result: NEW_OR_CHANGED"
            log_info "Collector exit code: ${collector_result}"
            log_info \
                "Firewall01 collector elapsed time: ${collector_elapsed_seconds} seconds."
 
            log_info "========================================================================"
            log_info "COLLECTOR END: Firewall01"
            log_info "Result: SUCCESS"
            log_info "========================================================================"
 
            return "${POLARIS_COLLECTOR_NEW_OR_CHANGED}"
            ;;
 
        "${POLARIS_COLLECTOR_RESULT_NO_CHANGE}")
            operator_info \
                "Firewall01 configuration is unchanged."
 
            log_info "Firewall01 collector completed successfully."
            log_info "Collector result: NO_CHANGE"
            log_info "Collector exit code: ${collector_result}"
            log_info \
                "Firewall01 collector elapsed time: ${collector_elapsed_seconds} seconds."
 
            log_info "========================================================================"
            log_info "COLLECTOR END: Firewall01"
            log_info "Result: NO_CHANGE"
            log_info "========================================================================"
 
            return "${POLARIS_COLLECTOR_NO_CHANGE}"
            ;;
 
        "${POLARIS_COLLECTOR_RESULT_ERROR}")
            operator_error \
                "Firewall01 collector encountered an error."
 
            log_error "Firewall01 collector failed."
            log_error "Collector result: ERROR"
            log_error "Collector exit code: ${collector_result}"
            log_error \
                "Firewall01 collector elapsed time: ${collector_elapsed_seconds} seconds."
 
            log_info "========================================================================"
            log_info "COLLECTOR END: Firewall01"
            log_info "Result: ERROR"
            log_info "========================================================================"
 
            return "${POLARIS_COLLECTOR_FAILED}"
            ;;
 
        *)
            operator_error \
                "Firewall01 collector returned an unexpected result."
 
            log_error \
                "Firewall01 collector returned unexpected exit code: ${collector_result}"
 
            log_error \
                "Firewall01 collector elapsed time: ${collector_elapsed_seconds} seconds."
 
            log_info "========================================================================"
            log_info "COLLECTOR END: Firewall01"
            log_info "Result: UNKNOWN_ERROR"
            log_info "========================================================================"
 
            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
            ;;
    esac
}

###############################################################################
# Function:
#     _run_gateway01_collector()
#
# Purpose:
#     Run Gateway01 (pfSense-based) collector.
###############################################################################

_run_gateway01_collector() {

    local collector_result
    local collector_start_seconds
    local collector_elapsed_seconds
    local baseline_file=""
    local nas_validated_archive=""

    collector_start_seconds="${SECONDS}"

    if [[ ! -r "${POLARIS_GATEWAY01_COLLECTOR}" ]]; then
        operator_error \
            "Gateway01 collector is not readable: ${POLARIS_GATEWAY01_COLLECTOR}"

        log_error \
            "Gateway01 collector is not readable: ${POLARIS_GATEWAY01_COLLECTOR}"

        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi

    if ! source "${POLARIS_GATEWAY01_COLLECTOR}"; then
        operator_error \
            "Unable to load Gateway01 collector: ${POLARIS_GATEWAY01_COLLECTOR}"

        log_error \
            "Unable to load Gateway01 collector: ${POLARIS_GATEWAY01_COLLECTOR}"

        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    if ! declare -F collect_gateway01 >/dev/null; then
        operator_error \
            "Gateway01 collector did not expose the required collect_gateway01 interface."

        log_error \
            "Gateway01 collector did not expose the required collect_gateway01 interface."

        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    operator_info "Running Gateway01 collector."

    log_info "========================================================================"
    log_info "COLLECTOR START: Gateway01"
    log_info "Run identity: ${POLARIS_RUN_TIMESTAMP}"
    log_info "Collector destination: ${POLARIS_GATEWAY01_WORKING_DIRECTORY}"
    log_info "Troubleshooting root: ${POLARIS_GATEWAY01_TROUBLESHOOTING_ROOT}"
    log_info "========================================================================"

    log_info \
        "Collector destination: ${POLARIS_GATEWAY01_WORKING_DIRECTORY}"

    nas_validated_archive="$(
        find "${POLARIS_NAS_VALIDATED_ROOT}/gateway01" \
            -mindepth 2 \
            -maxdepth 2 \
            -type f \
            -name 'Gateway01-*.tar.zst' \
            -printf '%T@ %p\n' \
            2>/dev/null \
        | sort -nr \
        | head -n 1 \
        | cut -d' ' -f2-
    )"

    if [[ -n "${nas_validated_archive}" ]]; then

        log_info \
            "Existing validated Gateway01 NAS backup located: ${nas_validated_archive}"

        baseline_file="$(
            find "${POLARIS_LOCAL_VALIDATED_ROOT}/gateway01" \
                -mindepth 3 \
                -maxdepth 3 \
                -type f \
                -path '*/configuration/config.xml' \
                -printf '%T@ %p\n' \
                2>/dev/null \
            | sort -nr \
            | head -n 1 \
            | cut -d' ' -f2-
        )"

        if [[ -n "${baseline_file}" ]]; then
            log_info \
                "Gateway01 comparison baseline located: ${baseline_file}"
        else
            operator_warning \
                "A validated Gateway01 NAS backup exists, but no local comparison baseline was found."

            log_warning \
                "A validated Gateway01 NAS backup exists, but no local comparison baseline was found."

            log_info \
                "The current Gateway01 configuration will be treated as new."
        fi

    else
        log_info \
            "No validated Gateway01 NAS backup exists. The current configuration will be treated as the initial backup."

        log_info \
            "No validated Gateway01 NAS backup exists. Local baseline comparison was intentionally skipped."
    fi

    collect_gateway01 \
        "${POLARIS_GATEWAY01_WORKING_DIRECTORY}" \
        "${baseline_file}" \
        "${POLARIS_GATEWAY01_TROUBLESHOOTING_ROOT}"

    collector_result=$?
    collector_elapsed_seconds=$((SECONDS - collector_start_seconds))

    case "${collector_result}" in
        "${POLARIS_COLLECTOR_RESULT_SUCCESS}")
            operator_success \
                "Gateway01 collector completed successfully."

            log_info "Gateway01 collector completed successfully."
            log_info "Collector result: NEW_OR_CHANGED"
            log_info "Collector exit code: ${collector_result}"
            log_info \
                "Gateway01 collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info "========================================================================"
            log_info "COLLECTOR END: Gateway01"
            log_info "Result: SUCCESS"
            log_info "========================================================================"

            return "${POLARIS_COLLECTOR_NEW_OR_CHANGED}"
            ;;

        "${POLARIS_COLLECTOR_RESULT_NO_CHANGE}")
            operator_info \
                "Gateway01 configuration is unchanged."

            log_info "Gateway01 collector completed successfully."
            log_info "Collector result: NO_CHANGE"
            log_info "Collector exit code: ${collector_result}"
            log_info \
                "Gateway01 collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info "========================================================================"
            log_info "COLLECTOR END: Gateway01"
            log_info "Result: NO_CHANGE"
            log_info "========================================================================"

            return "${POLARIS_COLLECTOR_NO_CHANGE}"
            ;;

        "${POLARIS_COLLECTOR_RESULT_ERROR}")
            operator_error \
                "Gateway01 collector encountered an error."

            log_error "Gateway01 collector failed."
            log_error "Collector result: ERROR"
            log_error "Collector exit code: ${collector_result}"
            log_error \
                "Gateway01 collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info "========================================================================"
            log_info "COLLECTOR END: Gateway01"
            log_info "Result: ERROR"
            log_info "========================================================================"

            return "${POLARIS_COLLECTOR_FAILED}"
            ;;

        *)
            operator_error \
                "Gateway01 collector returned an unexpected result."

            log_error \
                "Gateway01 collector returned unexpected exit code: ${collector_result}"

            log_error \
                "Gateway01 collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info "========================================================================"
            log_info "COLLECTOR END: Gateway01"
            log_info "Result: UNKNOWN_ERROR"
            log_info "========================================================================"

            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
            ;;
    esac
}

###############################################################################
# Function:
#     _run_opnsense_collector()
#
# Purpose:
#     Run OpnSense Collector
###############################################################################

_run_opnsense_collector() {

    local collector_result
    local collector_start_seconds
    local collector_elapsed_seconds
    local baseline_file=""
    local nas_validated_archive=""

    collector_start_seconds="${SECONDS}"

    if [[ ! -r "${POLARIS_OPNSENSE_COLLECTOR}" ]]; then
        operator_error \
            "OPNSense collector is not readable: ${POLARIS_OPNSENSE_COLLECTOR}"

        log_error \
            "OPNSense collector is not readable: ${POLARIS_OPNSENSE_COLLECTOR}"

        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi

    if ! source "${POLARIS_OPNSENSE_COLLECTOR}"; then
        operator_error \
            "Unable to load OPNSense collector: ${POLARIS_OPNSENSE_COLLECTOR}"

        log_error \
            "Unable to load OPNSense collector: ${POLARIS_OPNSENSE_COLLECTOR}"

        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    if ! declare -F collect_opnsense >/dev/null; then
        operator_error \
            "OPNSense collector did not expose the required collect_opnsense interface."

        log_error \
            "OPNSense collector did not expose the required collect_opnsense interface."

        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    operator_info "Running OPNSense collector."

    log_info "========================================================================"
    log_info "COLLECTOR START: OPNSense"
    log_info "Run identity: ${POLARIS_RUN_TIMESTAMP}"
    log_info "Collector destination: ${POLARIS_OPNSENSE_WORKING_DIRECTORY}"
    log_info "Troubleshooting root: ${POLARIS_OPNSENSE_TROUBLESHOOTING_ROOT}"
    log_info "========================================================================"

    log_info \
        "Collector destination: ${POLARIS_OPNSENSE_WORKING_DIRECTORY}"

    nas_validated_archive="$(
        find "${POLARIS_NAS_VALIDATED_ROOT}/opnsense" \
            -mindepth 2 \
            -maxdepth 2 \
            -type f \
            -name 'OPNsense-*.tar.zst' \
            -printf '%T@ %p\n' \
            2>/dev/null \
        | sort -nr \
        | head -n 1 \
        | cut -d' ' -f2-
    )"

    if [[ -n "${nas_validated_archive}" ]]; then

        log_info \
            "Existing validated OPNSense NAS backup located: ${nas_validated_archive}"

        log_info \
            "Existing validated OPNSense NAS backup located: ${nas_validated_archive}"

        baseline_file="$(
            find "${POLARIS_LOCAL_VALIDATED_ROOT}/opnsense" \
                -mindepth 3 \
                -maxdepth 3 \
                -type f \
                -path '*/configuration/config.xml' \
                -printf '%T@ %p\n' \
                2>/dev/null \
            | sort -nr \
            | head -n 1 \
            | cut -d' ' -f2-
        )"

        if [[ -n "${baseline_file}" ]]; then
            log_info \
                "OPNSense comparison baseline located: ${baseline_file}"

            log_info \
                "OPNSense comparison baseline located: ${baseline_file}"
        else
            operator_warning \
                "A validated OPNSense NAS backup exists, but no local comparison baseline was found."

            log_warning \
                "A validated OPNSense NAS backup exists, but no local comparison baseline was found."

            log_info \
                "The current OPNSense configuration will be treated as new."
        fi

    else
        log_info \
            "No validated OPNSense NAS backup exists. The current configuration will be treated as the initial backup."

        log_info \
            "No validated OPNSense NAS backup exists. Local baseline comparison was intentionally skipped."
    fi

    collect_opnsense \
        "${POLARIS_OPNSENSE_WORKING_DIRECTORY}" \
        "${baseline_file}" \
        "${POLARIS_OPNSENSE_TROUBLESHOOTING_ROOT}"

    collector_result=$?
    collector_elapsed_seconds=$((SECONDS - collector_start_seconds))

    case "${collector_result}" in
        "${POLARIS_COLLECTOR_RESULT_SUCCESS}")
            operator_success \
                "OPNSense collector completed successfully."

            log_info "OPNSense collector completed successfully."
            log_info "Collector result: NEW_OR_CHANGED"
            log_info "Collector exit code: ${collector_result}"
            log_info \
                "OPNSense collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info "========================================================================"
            log_info "COLLECTOR END: OPNSense"
            log_info "Result: SUCCESS"
            log_info "========================================================================"

            return "${POLARIS_COLLECTOR_NEW_OR_CHANGED}"
            ;;

        "${POLARIS_COLLECTOR_RESULT_NO_CHANGE}")
            operator_info \
                "OPNSense configuration is unchanged."

            log_info "OPNSense collector completed successfully."
            log_info "Collector result: NO_CHANGE"
            log_info "Collector exit code: ${collector_result}"
            log_info \
                "OPNSense collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info "========================================================================"
            log_info "COLLECTOR END: OPNSense"
            log_info "Result: NO_CHANGE"
            log_info "========================================================================"

            return "${POLARIS_COLLECTOR_NO_CHANGE}"
            ;;

        "${POLARIS_COLLECTOR_RESULT_ERROR}")
            operator_error \
                "OPNSense collector encountered an error."

            log_error "OPNSense collector failed."
            log_error "Collector result: ERROR"
            log_error "Collector exit code: ${collector_result}"
            log_error \
                "OPNSense collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info "========================================================================"
            log_info "COLLECTOR END: OPNSense"
            log_info "Result: ERROR"
            log_info "========================================================================"

            return "${POLARIS_COLLECTOR_FAILED}"
            ;;

        *)
            operator_error \
                "OPNSense collector returned an unexpected result."

            log_error \
                "OPNSense collector returned unexpected exit code: ${collector_result}"

            log_error \
                "OPNSense collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info "========================================================================"
            log_info "COLLECTOR END: OPNSense"
            log_info "Result: UNKNOWN_ERROR"
            log_info "========================================================================"

            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
            ;;
    esac
}

###############################################################################
# Function:
#     _run_docker_collector
#
# Purpose:
#     Load and execute the Docker01 configuration collector.
#
# Returns:
#     POLARIS_COLLECTOR_NEW_OR_CHANGED - Collection completed successfully.
#     POLARIS_COLLECTOR_FAILED         - Collection failed.
#     POLARIS_COLLECTOR_NO_CHANGE      - Reserved for future no-change support.
#     POLARIS_BACKUP_*                 - Orchestrator prerequisite or internal
#                                        processing failure.
###############################################################################

_run_docker_collector() {

    local collector_result
    local collector_start_seconds
    local collector_elapsed_seconds

    collector_start_seconds="${SECONDS}"

    if [[ ! -r "${POLARIS_DOCKER_COLLECTOR}" ]]; then
        operator_error \
            "Docker01 collector is not readable: ${POLARIS_DOCKER_COLLECTOR}"

        log_error \
            "Docker01 collector is not readable: ${POLARIS_DOCKER_COLLECTOR}"

        return "${POLARIS_BACKUP_PREREQUISITE_FAILED}"
    fi

    if ! source "${POLARIS_DOCKER_COLLECTOR}"; then
        operator_error \
            "Unable to load Docker01 collector: ${POLARIS_DOCKER_COLLECTOR}"

        log_error \
            "Unable to load Docker01 collector: ${POLARIS_DOCKER_COLLECTOR}"

        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    if ! declare -F collect_docker >/dev/null; then
        operator_error \
            "Docker01 collector did not expose the required collect_docker interface."

        log_error \
            "Docker01 collector did not expose the required collect_docker interface."

        return "${POLARIS_BACKUP_INTERNAL_ERROR}"
    fi

    operator_info "Running Docker01 collector."

    log_info \
        "========================================================================"
    log_info "COLLECTOR START: Docker01"
    log_info "Run identity: ${POLARIS_RUN_TIMESTAMP}"
    log_info \
        "Collector destination: ${POLARIS_DOCKER_WORKING_DIRECTORY}"
    log_info \
        "Troubleshooting root: ${POLARIS_DOCKER_TROUBLESHOOTING_ROOT}"
    log_info \
        "========================================================================"

    log_info \
        "Collector destination: ${POLARIS_DOCKER_WORKING_DIRECTORY}"

    collect_docker \
        "${POLARIS_DOCKER_WORKING_DIRECTORY}" \
        "${POLARIS_DOCKER_TROUBLESHOOTING_ROOT}"

    collector_result=$?
    collector_elapsed_seconds=$((SECONDS - collector_start_seconds))

    case "${collector_result}" in

        "${POLARIS_COLLECTOR_RESULT_SUCCESS}")
            operator_success \
                "Docker01 collector completed successfully."

            log_info "Docker01 collector completed successfully."
            log_info "Collector result: NEW_OR_CHANGED"
            log_info "Collector exit code: ${collector_result}"
            log_info \
                "Docker01 collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info \
                "========================================================================"
            log_info "COLLECTOR END: Docker01"
            log_info "Result: SUCCESS"
            log_info \
                "========================================================================"

            return "${POLARIS_COLLECTOR_NEW_OR_CHANGED}"
            ;;

        "${POLARIS_COLLECTOR_RESULT_NO_CHANGE}")
            operator_info \
                "Docker01 configuration is unchanged."

            log_info "Docker01 collector completed successfully."
            log_info "Collector result: NO_CHANGE"
            log_info "Collector exit code: ${collector_result}"
            log_info \
                "Docker01 collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info \
                "========================================================================"
            log_info "COLLECTOR END: Docker01"
            log_info "Result: NO_CHANGE"
            log_info \
                "========================================================================"

            return "${POLARIS_COLLECTOR_NO_CHANGE}"
            ;;

        "${POLARIS_COLLECTOR_RESULT_ERROR}")
            operator_error \
                "Docker01 collector encountered an error."

            log_error "Docker01 collector failed."
            log_error "Collector result: ERROR"
            log_error "Collector exit code: ${collector_result}"
            log_error \
                "Docker01 collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info \
                "========================================================================"
            log_info "COLLECTOR END: Docker01"
            log_info "Result: ERROR"
            log_info \
                "========================================================================"

            return "${POLARIS_COLLECTOR_FAILED}"
            ;;

        *)
            operator_error \
                "Docker01 collector returned an unexpected result."

            log_error \
                "Docker01 collector returned unexpected exit code: ${collector_result}"

            log_error \
                "Docker01 collector elapsed time: ${collector_elapsed_seconds} seconds."

            log_info \
                "========================================================================"
            log_info "COLLECTOR END: Docker01"
            log_info "Result: UNKNOWN_ERROR"
            log_info \
                "========================================================================"

            return "${POLARIS_BACKUP_INTERNAL_ERROR}"
            ;;
    esac
}

